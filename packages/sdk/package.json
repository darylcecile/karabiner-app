{
  "name": "@karabiner/sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TypeScript SDK for Karabiner extensions",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun tsc -p tsconfig.json",
    "typecheck": "bun tsc -p tsconfig.json --noEmit"
  }
}
