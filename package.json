{
  "name": "karabiner-app",
  "version": "0.1.0",
  "description": "Karabiner — a desktop app built with Electrobun",
  "scripts": {
    "start": "vite build && electrobun dev",
    "dev": "electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "build": "vite build && electrobun build",
    "build:canary": "vite build && electrobun build --env=canary"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.68",
    "@ai-sdk/openai": "^3.0.52",
    "@ai-sdk/react": "^3.0.158",
    "@blocknote/core": "^0.47.3",
    "@blocknote/react": "^0.47.3",
    "@electric-sql/pglite": "^0.4.4",
    "@hugeicons/core-free-icons": "^4.1.1",
    "@hugeicons/react": "^1.1.6",
    "@pierre/trees": "0.0.1-beta.4",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "ai": "^6.0.156",
    "electrobun": "^1.15.1",
    "motion": "^12.38.0",
    "quickjs-emscripten": "^0.32.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shiki": "^4.0.2",
    "tldraw": "^4.5.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
