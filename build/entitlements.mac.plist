<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron + V8 need these for JIT under hardened runtime -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>

  <!-- We spawn child binaries (gh / copilot CLI / native helpers); these
       binaries are signed by their own publishers, not by us. Allow loading
       them and let them inherit our entitlements. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>

  <!-- The Copilot/gh CLIs make HTTPS requests; the app uses the network for
       AI providers and the optional update check. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <key>com.apple.security.network.server</key>
  <true/>

  <!-- The vault lives anywhere the user picks (Documents, iCloud, Desktop). -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.files.downloads.read-write</key>
  <true/>
</dict>
</plist>
