{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"types": [
			"electron-vite/node"
		],
		"paths": {
			"@/*": [
				"./electron/*"
			]
		}
	},
	"include": [
		"electron",
		"src",
		"electron.vite.config.ts"
	]
}